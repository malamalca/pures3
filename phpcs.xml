
<ruleset name="App">
    <config name="installed_paths" value="../../cakephp/cakephp-codesniffer"/>
    <rule ref="CakePHP"/>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>./src/Calc/Hrup/Elementi/Izbire/TipKonstrukcije.php</exclude-pattern>
    </rule>
    <!-- Brisanje začasnega profila brskalnika je najboljši poskus - datoteke so lahko še zaklenjene -->
    <rule ref="Generic.PHP.NoSilencedErrors">
        <exclude-pattern>./src/Core/PDF/ChromeEngine.php</exclude-pattern>
    </rule>
    <file>src/</file>
    <file>tests/</file>
</ruleset>